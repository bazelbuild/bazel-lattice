# Enable disk cache for local builds
build --disk_cache=~/.cache/bazel-disk-cache

# RBE / gRPC Remote Cache configuration (local bazel-remote over veth pair 10.200.1.2:9092)
build:remote --disk_cache=
build:remote --remote_cache=grpc://10.200.1.2:9092
build:remote --remote_download_toplevel
build:remote --remote_timeout=600
build:remote --jobs=200

# Pure local execution / sandboxing benchmark configuration (no disk/remote cache, cl/993497829 enabled for Bazel 10)
build:local_exec --disk_cache=
build:local_exec --experimental_inmemory_sandbox_stashes

# Suppress external warnings
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w
